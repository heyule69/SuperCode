{
  "name": "supercode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "installer:build": "node scripts/build-installer.mjs",
    "installer:test": "cargo test --manifest-path installer/Cargo.toml --target-dir src-tauri/target",
    "installer:test:ui": "node scripts/test-installer-ui.mjs",
    "installer:test:update-ui": "node scripts/test-installer-update-ui.mjs",
    "release:test": "node --test scripts/test-release-contract.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "check": "tsc -b",
    "check:encoding": "node scripts/verify-utf8.mjs",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:integration": "cargo run --manifest-path src-tauri/Cargo.toml -- --smoke-test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.14.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
