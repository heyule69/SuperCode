{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperCode Installer",
  "version": "0.1.0",
  "identifier": "dev.supercode.installer",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "SuperCode", "width": 700, "height": 574, "resizable": false, "maximizable": false, "decorations": false, "center": true, "visible": false, "backgroundColor": "#1b1c1f" }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["../src-tauri/icons/icon.ico", "../src-tauri/icons/32x32.png", "../src-tauri/icons/128x128.png"] }
}
